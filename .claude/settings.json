{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff check --fix \"$CLAUDE_FILE_PATHS\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[docs-reminder] >30min bug this session? -> /log-failure | insight? -> /log-lesson | decision made? -> DECISIONS.md entry'"
          }
        ]
      }
    ]
  }
}
